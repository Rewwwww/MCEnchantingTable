<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
  <Import Project=".\Sts2PathDiscovery.props" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework><AssemblyName>MCEnchantingTable</AssemblyName><RootNamespace>MCEnchantingTable.Loader</RootNamespace>
    <ImplicitUsings>true</ImplicitUsings><Nullable>enable</Nullable><GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators><NoWarn>$(NoWarn);MSB3270</NoWarn>
    <BetaSts2DataDir Condition="'$(BetaSts2DataDir)' == ''">$(MSBuildProjectDirectory)\..\StS2_Decompiled\.godot\mono\temp\bin\Debug</BetaSts2DataDir>
    <ReleaseSts2DataDir Condition="'$(ReleaseSts2DataDir)' == ''">$(MSBuildProjectDirectory)\..\StS2_Decompiled_Release\.godot\mono\temp\bin\Debug</ReleaseSts2DataDir>
    <SharedGameDataDir Condition="'$(SharedGameDataDir)' == ''">$(Sts2DataDir)</SharedGameDataDir>
    <VariantBuildRoot>$(MSBuildProjectDirectory)\artifacts\variants\$(Configuration)</VariantBuildRoot>
    <PackageRoot>$(MSBuildProjectDirectory)\artifacts\publish\MCEnchantingTable</PackageRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(ReleaseSts2DataDir)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SharedGameDataDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(SharedGameDataDir)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Compile Remove="MCEnchantingTableCode\**\*.cs" /><Compile Remove="MCEnchantingTable\**\*.cs" />
    <EmbeddedResource Remove="MCEnchantingTable\**" /><None Include="MCEnchantingTable.json" /><None Include="mc-enchanting-variants.manifest" /><None Include="project.godot" /><None Include="MCEnchantingTable\**" />
  </ItemGroup>
  <Target Name="CheckDependencyPaths">
    <Error Text="Beta sts2.dll was not found at '$(BetaSts2DataDir)'." Condition="!Exists('$(BetaSts2DataDir)\sts2.dll')" />
    <Error Text="Release sts2.dll was not found at '$(ReleaseSts2DataDir)'." Condition="!Exists('$(ReleaseSts2DataDir)\sts2.dll')" />
    <Error Text="Shared game dependencies were not found at '$(SharedGameDataDir)'." Condition="!Exists('$(SharedGameDataDir)\0Harmony.dll') Or !Exists('$(SharedGameDataDir)\GodotSharp.dll')" />
  </Target>
  <Target Name="BuildContentVariants" BeforeTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\MCEnchantingTable.Content.csproj" Targets="Restore;Build" BuildInParallel="false" Properties="Configuration=$(Configuration);StS2Target=Beta;BetaSts2DataDir=$(BetaSts2DataDir);ReleaseSts2DataDir=$(ReleaseSts2DataDir);SharedGameDataDir=$(SharedGameDataDir);OutputPath=$(VariantBuildRoot)\beta\;BaseIntermediateOutputPath=$(MSBuildProjectDirectory)\.variant-obj\beta\" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\MCEnchantingTable.Content.csproj" Targets="Restore;Build" BuildInParallel="false" Properties="Configuration=$(Configuration);StS2Target=Release;BetaSts2DataDir=$(BetaSts2DataDir);ReleaseSts2DataDir=$(ReleaseSts2DataDir);SharedGameDataDir=$(SharedGameDataDir);OutputPath=$(VariantBuildRoot)\release\;BaseIntermediateOutputPath=$(MSBuildProjectDirectory)\.variant-obj\release\" />
  </Target>
  <Target Name="AssembleVariantPackage" AfterTargets="Publish">
    <RemoveDir Directories="$(PackageRoot)" /><MakeDir Directories="$(PackageRoot)\lib\beta;$(PackageRoot)\lib\release" />
    <Copy SourceFiles="$(PublishDir)MCEnchantingTable.dll;$(MSBuildProjectDirectory)\MCEnchantingTable.json;$(MSBuildProjectDirectory)\mc-enchanting-variants.manifest" DestinationFolder="$(PackageRoot)" />
    <Copy SourceFiles="$(VariantBuildRoot)\beta\MCEnchantingTable.Content.dll" DestinationFolder="$(PackageRoot)\lib\beta" />
    <Copy SourceFiles="$(VariantBuildRoot)\release\MCEnchantingTable.Content.dll" DestinationFolder="$(PackageRoot)\lib\release" />
    <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(PackageRoot)\MCEnchantingTable.pck&quot;" EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1" ContinueOnError="WarnAndContinue" Condition="'$(GodotPath)' != '' And Exists('$(GodotPath)')" />
    <MakeDir Directories="$(ModsPath)MCEnchantingTable" Condition="'$(DeployPackage)' != 'false'" />
    <ItemGroup Condition="'$(DeployPackage)' != 'false'"><PackageFiles Include="$(PackageRoot)\**\*" /></ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFiles="@(PackageFiles->'$(ModsPath)MCEnchantingTable\%(RecursiveDir)%(Filename)%(Extension)')" Condition="'$(DeployPackage)' != 'false'" />
  </Target>
  <Target Name="PublishBetaTest" DependsOnTargets="Publish"><Error Text="Set BetaModsPath to the Beta game's mods directory." Condition="'$(BetaModsPath)' == ''" /><ItemGroup><BetaPackageFiles Include="$(PackageRoot)\**\*" /></ItemGroup><Copy SourceFiles="@(BetaPackageFiles)" DestinationFiles="@(BetaPackageFiles->'$(BetaModsPath)\MCEnchantingTable\%(RecursiveDir)%(Filename)%(Extension)')" /></Target>
  <Target Name="PublishReleaseTest" DependsOnTargets="Publish"><Error Text="Set ReleaseModsPath to the Release game's mods directory." Condition="'$(ReleaseModsPath)' == ''" /><ItemGroup><ReleasePackageFiles Include="$(PackageRoot)\**\*" /></ItemGroup><Copy SourceFiles="@(ReleasePackageFiles)" DestinationFiles="@(ReleasePackageFiles->'$(ReleaseModsPath)\MCEnchantingTable\%(RecursiveDir)%(Filename)%(Extension)')" /></Target>
</Project>
